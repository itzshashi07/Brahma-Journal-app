rules_version = '2';

// Brahma Journal — Cloud Storage rules
//
// There was no rules file at all before this, so the bucket ran on whatever
// default the console last applied — in practice open enough that anyone with
// the (public) Firebase config could list, read, and overwrite objects. Now
// that avatars live here, that would mean any user replacing any other user's
// profile picture, or uploading arbitrary files to your bucket at your expense.
//
// Everything is denied unless a rule below allows it.

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.get('admin', false) == true;
    }

    // Avatars are displayed on the Community leaderboard, so any signed-in
    // member may read them — but only the owner may write their own, and the
    // path itself is keyed by uid so ownership is structural rather than
    // something the client asserts in a field.
    match /avatars/{userId}/{fileName} {
      allow read: if isSignedIn();

      allow write: if isSignedIn()
                   && request.auth.uid == userId
                   // 5 MB ceiling: an unbounded upload path is a way to run up
                   // a storage bill on someone else's project.
                   && request.resource.size < 5 * 1024 * 1024
                   // Images only. Without this, the bucket becomes free file
                   // hosting for whatever anyone wants to serve from your
                   // domain — including HTML, which browsers would execute.
                   && request.resource.contentType.matches('image/(jpeg|png|webp)');

      allow delete: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    // Product cover art and any other operator-managed media.
    match /public/{allPaths=**} {
      allow read: if true;
      allow write, delete: if isAdmin();
    }

    // Voice notes from a counselling session.
    //
    // These are recordings of a real person describing a mental health problem,
    // so they are the most sensitive objects this bucket will ever hold. Two
    // consequences:
    //
    //   • Storage rules cannot read Firestore, so this path cannot verify that
    //     the caller owns the session the way firestore.rules does. It is
    //     therefore restricted to signed-in users, and secrecy rests on the
    //     session id — a Firestore auto-id, 20 characters of unguessable
    //     entropy — never being readable by anyone outside the conversation.
    //     firestore.rules is what enforces that: the session document and its
    //     messages, which are the only places the id and the download URL
    //     appear, are owner-and-admin only.
    //
    //   • Delete has to stay open to any signed-in caller for the same reason:
    //     the two-hour purge runs on the client, from the member's device as
    //     well as the operator's, and it must be able to destroy the audio it
    //     can no longer identify an owner for. An attacker who somehow held a
    //     session id could delete a recording — which is the failure direction
    //     to prefer over one where they could read it.
    match /counselling/{sessionId}/{fileName} {
      allow read: if isSignedIn();

      allow write: if isSignedIn()
                   // 25 MB covers the three-minute cap the recorder enforces,
                   // at the AAC bitrate it records with, several times over.
                   && request.resource.size < 25 * 1024 * 1024
                   && request.resource.contentType.matches('audio/.*');

      allow delete: if isSignedIn();
    }

    // Anything not matched above is denied.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
