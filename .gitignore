**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Dotenv local environment files
.env
.env.*

# Gradle build reports
android/build/
android/app/build/

# Release signing — the upload key and its passwords.
#
# Losing these means you can never update the app on Play again under the same
# listing, and leaking them means somebody else can sign a build as you. Back
# the .jks up somewhere private and offline; never commit it.
android/key.properties
*.jks
*.keystore
