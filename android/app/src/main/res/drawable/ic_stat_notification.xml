<!--
  Status-bar notification icon.

  Android draws this as a silhouette: it discards every colour in the source
  and keeps only the alpha channel. A full-colour launcher icon used here comes
  out as a solid white square, which is the single most common notification-icon
  bug and looks like a rendering fault rather than a choice.

  So this is authored the way the platform wants: one flat white shape on
  transparency, no gradients and no strokes. The form is the app's lotus motif
  reduced to what survives at 24dp in a status bar — a centred bloom over a
  horizontal rest line.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="#FFFFFFFF">

    <!-- Centre petal. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M12,3.2c1.9,2.1 2.9,4.2 2.9,6.3c0,2.1 -1,3.7 -2.9,5.1c-1.9,-1.4 -2.9,-3 -2.9,-5.1c0,-2.1 1,-4.2 2.9,-6.3z" />

    <!-- Outer petals, mirrored about the vertical axis. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M5.1,7.6c2.4,0.6 4.1,1.7 5.1,3.2c1,1.5 1.2,3.1 0.7,5c-1.9,-0.5 -3.3,-1.4 -4.3,-2.9c-1,-1.5 -1.5,-3.3 -1.5,-5.3z" />
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M18.9,7.6c0,2 -0.5,3.8 -1.5,5.3c-1,1.5 -2.4,2.4 -4.3,2.9c-0.5,-1.9 -0.3,-3.5 0.7,-5c1,-1.5 2.7,-2.6 5.1,-3.2z" />

    <!-- The rest line the bloom sits on. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M4.5,17.4h15c0.5,0 0.9,0.4 0.9,0.9c0,0.5 -0.4,0.9 -0.9,0.9h-15c-0.5,0 -0.9,-0.4 -0.9,-0.9c0,-0.5 0.4,-0.9 0.9,-0.9z" />
</vector>
